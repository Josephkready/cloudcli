# CloudCLI UI Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'cloudcli status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   cloudcli start    - Start the server
#   cloudcli status   - Show configuration and data locations
#   cloudcli usage    - Show local feature-usage counters (least-used first)
#   cloudcli help     - Show help information
#   cloudcli version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Graceful-drain window on shutdown (SIGTERM/SIGINT), in milliseconds.
# On shutdown the server stops accepting new chat runs and gives in-flight
# runs this long to finish before exiting, so a deploy/restart is less likely
# to guillotine a turn mid-stream. Runs still active at the deadline are
# surfaced as interrupted + resumable after the restart. Read once at startup.
# CHAT_DRAIN_TIMEOUT_MS=10000

# Stale-run reaper window, in milliseconds (default 45 min; 0 disables).
# A chat run only leaves the "running" set when its provider emits a terminal
# `complete`. If a provider generator wedges without ever emitting one (a
# never-EOF stream, a stuck tool, a child that died without closing its pipe),
# the session would show "running" forever. This window is how long a running,
# non-blocked run may stream nothing before the reaper force-completes it.
# Deliberately generous: event silence alone can't tell a wedged run from one
# mid-way through a long, quiet tool call, so keep it well beyond any legitimate
# single-tool duration. Runs blocked on a permission/plan prompt are exempt.
# CLOUDCLI_RUN_INACTIVITY_TIMEOUT_MS=2700000

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# Maximum filesystem operations the server runs concurrently (default 64).
# Directory walks and file reads queue behind this limit so a large project
# tree cannot exhaust libuv's thread pool and stall unrelated requests. Raise it
# on fast NVMe with a deep tree, lower it if the box is I/O bound. Values that
# are not a positive integer fall back to the default.
# FS_CONCURRENCY=64

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db

# Local feature-usage counters (issue #248).
# The app keeps one aggregate row per feature key in the `feature_usage` table
# of the same auth.db above: a count plus the first/last time that feature was
# touched. No event log, no arguments, no content, and nothing ever leaves this
# machine — it exists so a later deletion pass can be driven by evidence about
# what actually gets used instead of guesswork.
#
# Read it with:   cloudcli usage            (every key, least-used first)
#                 cloudcli usage --json     (machine-readable)
# Reset it with:  cloudcli usage --clear
#
# Set to false to stop recording entirely (any of false/0/off/no). Recording is
# on by default; the server drops the writes AND tells the client to stop
# sending when this is off. Read at request time, so a restart applies it.
# FEATURE_USAGE_ENABLED=true

# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Disable the login/setup screen for single-user, self-hosted installs.
# When set to 'true', the app skips all login and JWT checks and runs as a
# single default user (auto-created on first start). This ONLY removes login —
# it does not change workspace paths, the WebSocket URL, or platform behavior.
# Leave unset (or 'false') to keep the normal username/password login.
#
# Read once at startup, so after changing it you must BOTH rebuild the frontend
# (VITE_ vars are inlined at build time) AND restart the server process.
#
# One-way caveat: the auto-created default user has no usable password. Once
# this has run with the flag on, turning it back off leaves you unable to log
# in (registration is blocked while any user exists). To re-enable login later,
# delete the auto-created user row (or the auth database) first, then unset this.
# VITE_AUTH_DISABLED=true

# Test-only. When 'true', chat runs (and POST /api/agent) are served by the
# deterministic in-process mock provider instead of a real CLI/SDK — no network,
# process, or auth. This is what the Playwright e2e suite drives (see e2e/).
# Leave unset in normal use.
# AGENT_MOCK_PROVIDER=true

# =============================================================================
# PROJECT DISCOVERY
# =============================================================================

# Colon-separated globs of project paths to exclude from auto-discovery.
# Sessions whose recorded cwd matches any pattern are skipped during the
# provider session sync, so transient worktrees never clutter the sidebar.
# Set to empty (CLOUDCLI_EXCLUDED_PROJECT_PATHS=) to disable all exclusions.
# Glob syntax: `**` matches any chars including `/`; `*` matches any chars
# except `/`; `?` matches one char except `/`. Everything else is literal.
# Default: /tmp/**:**/worktrees/**:**/.dante-sync-clobbered/**
# CLOUDCLI_EXCLUDED_PROJECT_PATHS=/tmp/**:**/worktrees/**

# =============================================================================
# WORKSPACE ROOT / FOLDER PICKER
# =============================================================================

# Root directory that confines all workspace/project paths. This is the single
# lever that scopes the new-project / new-conversation folder browser AND the
# server-side guards: the browse-filesystem picker opens here, `~` in supplied
# paths expands to it, and new-project / create-folder / path-validation reject
# anything resolving outside it. Set it to a narrow workspace (e.g. ~/repos) so
# the picker lists only your code, not the entire home tree.
# Default: the current user's home directory.
# WORKSPACES_ROOT=/home/youruser/repos

# Comma-separated "common" directory names promoted to the top of the folder
# picker when browsing the workspace root (a convenience for home-rooted setups).
# - unset  -> the historical default list below (backward compatible)
# - empty  -> reordering disabled; the picker shows a plain sorted list (nice
#             when WORKSPACES_ROOT is a narrow root where these names never appear)
# - custom -> your own comma-separated list, e.g. BROWSE_COMMON_DIRS=repos,work
# Default list: Desktop,Documents,Projects,Development,Dev,Code,workspace
# BROWSE_COMMON_DIRS=

# =============================================================================
# REVERSE PROXY HOSTING
# =============================================================================

# React Router basename injected into index.html as `window.__ROUTER_BASENAME__`.
# Set this when serving the SPA behind a reverse-proxy path prefix (for example
# https://example.com/cloudcli/) so React Router knows its mount point and
# client-side navigation does not unmount the app. Must start with a slash and
# match the proxy prefix exactly, with no trailing slash. Leave unset (or empty)
# for normal root-path hosting — that path is fully backwards-compatible.
# Example: ROUTER_BASENAME=/cloudcli
# ROUTER_BASENAME=

# =============================================================================
# AI SESSION TITLES (hosted LM)
# =============================================================================

# Rewrite the long "first-prompt" session titles into short sidebar labels using
# a hosted chat model. A background worker periodically finds raw, long titles
# and replaces them; manually-renamed titles and already-shortened ones are left
# untouched, and the sidebar updates live. Opt-in and OFF by default. Server-side
# only — no frontend rebuild, but restart the server after changing these.
#
# PRIVACY: a title is generated from the session's opening message, so enabling
# this sends that text to the configured endpoint. By default routing is pinned
# to zero-data-retention providers (see CLOUDCLI_AI_TITLES_ZDR below).
# CLOUDCLI_AI_TITLES_ENABLED=true

# API key. Required — the worker refuses to start without one, rather than
# hammering the endpoint with requests that can only fail. For an endpoint that
# needs no auth, any non-empty placeholder works.
# CLOUDCLI_AI_TITLES_API_KEY=sk-or-v1-...

# ...or read the key from a protected file instead of the environment. Only the
# first CLOUDCLI_AI_TITLES_API_KEY= line is taken, falling back to
# OPENROUTER_API_KEY=, so this can point at a credential file shared with other
# services without importing the rest of its contents. Read once at startup.
# CLOUDCLI_AI_TITLES_API_KEY_FILE=/etc/cloudcli.env

# OpenAI-compatible API root (default: https://openrouter.ai/api/v1). Any
# OpenAI-compatible /chat/completions endpoint works, including a local one.
# CLOUDCLI_AI_TITLES_BASE_URL=https://openrouter.ai/api/v1

# Model to use (default: openai/gpt-5-nano). A flash-tier model is plenty for a
# 5-word label; this one costs roughly $0.01 per 1,000 titles.
# CLOUDCLI_AI_TITLES_MODEL=openai/gpt-5-nano

# Restrict OpenRouter routing to zero-data-retention endpoints. ON unless set to
# exactly "false" — this is the privacy mitigation for sending the opening
# message off-box, so only turn it off deliberately (an OpenAI-compatible
# endpoint that rejects an unknown `provider` field is the reason to).
# Sent as provider={"zdr":true,"require_parameters":true} — the second flag
# matters, because ZDR filters for policy and never for capability, so without it
# a request can land on an endpoint that silently ignores parameters it does not
# support.
# CLOUDCLI_AI_TITLES_ZDR=true

# Reasoning effort (default: minimal — the default model is a reasoning model and
# would otherwise spend ~128 thinking tokens on a 5-word title, ~8x the cost and
# ~1s more latency). Set to empty to omit the parameter entirely, which is
# REQUIRED for models whose endpoints do not support it: under
# require_parameters an unsupported parameter is a hard 404, not a silent drop.
# CLOUDCLI_AI_TITLES_REASONING_EFFORT=

# Which output-cap parameter the model's endpoints accept. The default below is
# what OpenAI-family models want; most non-OpenAI models want "max_tokens"
# instead, so CHANGE THIS IF YOU CHANGE THE MODEL — under require_parameters the
# wrong name filters every endpoint out and 404s every request rather than being
# ignored. Check with `or-models endpoints <model-id> --zdr` before assuming.
# CLOUDCLI_AI_TITLES_MAX_TOKENS_PARAM=max_completion_tokens

# Worker cadence and batch size. Kept gentle so a first-time backfill is a slow
# drip rather than a burst. Defaults: tick every 5000ms, 5 titles per tick.
# CLOUDCLI_AI_TITLES_INTERVAL_MS=5000
# CLOUDCLI_AI_TITLES_BATCH=5

# Only rewrite titles longer than this many characters (default: 60), so short
# titles that already read well are never touched.
# CLOUDCLI_AI_TITLES_MIN_LEN=60

# =============================================================================
# VOICE INPUT / OUTPUT (STT + TTS proxy)
# =============================================================================

# The in-chat microphone and the Voice settings tab proxy speech-to-text and
# text-to-speech through server/voice-proxy.js to an OpenAI-compatible audio
# backend (its /audio/transcriptions and /audio/speech endpoints). The feature
# is DARK until VOICE_API_BASE_URL is set — with it unset the proxy has no
# upstream to call, so the mic button does nothing. Server-side only (read on
# each request), so restart the server after changing these; no frontend rebuild.

# Base URL of the OpenAI-compatible audio backend (a trailing slash is trimmed).
# Set this to enable voice; leave unset to keep the feature dark. Examples:
#   - OpenAI:  https://api.openai.com/v1
#   - dante:   http://127.0.0.1:8853/v1
#     On the dante VM, STT + TTS run against a loopback OpenAI-compatible backend
#     (the `aloud` service) bound to 127.0.0.1 — so audio never leaves the box and
#     no API key is needed. This is the target config for the cloudcli.service deploy.
#     NOTE: STT stays dark until aloud's POST /v1/audio/transcriptions route ships
#     (tracked in #82) — uncommenting this enables the mic UI but not transcription yet.
# VOICE_API_BASE_URL=http://127.0.0.1:8853/v1

# Bearer key sent to that backend (leave blank if it needs no auth — the dante
# loopback backend above needs none).
# VOICE_API_KEY=

# --- Split STT onto its own backend (optional) -------------------------------
# Both endpoints are looked up under VOICE_API_BASE_URL, so a single base URL
# forces STT and TTS onto the same provider. These two overrides break that tie;
# unset, they fall back to VOICE_API_BASE_URL / VOICE_API_KEY and behaviour is
# unchanged.
#
# The case they exist for: local transcription on a CPU box is slow (measured on
# dante, whisper small.en on CPU is ~8s median for a ~10s clip), while local
# Kokoro TTS is good and free. Pointing VOICE_API_BASE_URL at a hosted
# transcriber to fix the mic would take TTS with it and break the speak button,
# because the hosted provider does not serve the local TTS voice. Split instead:
#   VOICE_STT_BASE_URL=https://api.groq.com/openai/v1   # mic -> hosted, fast
#   VOICE_STT_API_KEY=gsk_...
#   VOICE_API_BASE_URL=http://127.0.0.1:8853/v1         # speaker -> local, free
#
# Note the privacy consequence before enabling: dictated audio leaves the box.
# VOICE_STT_BASE_URL=
# VOICE_STT_API_KEY=
#
# Or hand over a PATH instead of the key, and the secret never enters this
# process's environment at all. That matters here specifically: cloudcli passes
# its own env to every agent it spawns, so a key set as VOICE_STT_API_KEY above
# is readable by all of them. The app reads only VOICE_STT_API_KEY (then
# GROQ_API_KEY) out of the named file, so a file shared with other services does
# not drag its unrelated secrets in — which a systemd EnvironmentFile= would.
# VOICE_STT_API_KEY_FILE=/home/youruser/.config/cloudcli/.env

# Model names to request. Defaults target OpenAI's audio API (STT: whisper-1,
# TTS: tts-1, voice: alloy); override to match your backend. The dante loopback
# backend serves a faster-whisper STT model plus a Kokoro TTS voice:
# VOICE_STT_MODEL=whisper-large-v3-turbo
# VOICE_TTS_MODEL=kokoro-am_puck
# VOICE_TTS_VOICE=am_puck

# Per-request timeout in milliseconds before the proxy aborts a slow backend
# (default: 300000 = 5 minutes).
# VOICE_TIMEOUT_MS=300000

# =============================================================================
# BUG REPORTER (in-app "Report a bug" button)
# =============================================================================

# The bug reporter in the app's top panel inserts GitHub issues into the
# host-local durable queue. The app returns once SQLite owns the report; the
# separate worker owns GitHub credentials, throttling, retries, and uncertain
# create reconciliation. The producer and worker must use the same database.

# Queue CLI executable. Defaults to `issue-queue` on PATH.
# BUG_REPORT_QUEUE_BIN=/opt/issue-queue/.venv/bin/issue-queue

# Local enqueue/status command timeout in milliseconds. Defaults to 5000.
# BUG_REPORT_QUEUE_TIMEOUT_MS=5000

# Shared durable SQLite queue path. Defaults to the queue CLI's per-user path.
# ISSUE_QUEUE_DB=/var/lib/issue-queue/queue.db

# Repository the reports are filed against, as `owner/name`. Defaults to
# Josephkready/cloudcli. A malformed value falls back to that default rather
# than being handed to the queue.
# BUG_REPORT_REPO=Josephkready/cloudcli

# =============================================================================
# BUILD (asset precompression)
# =============================================================================

# Brotli quality (0-11) used by the build-time asset precompression step
# (`npm run build:precompress`, also run by scripts/dante-build.sh), which
# writes the `<asset>.br` / `<asset>.gz` siblings the server hands straight to
# the client. Default 11 — the smallest and slowest setting, affordable because
# it runs once per build rather than once per request. Lower it when a faster
# build matters more than a few KB on the wire. Build-time only: it has no
# effect on a running server, and changing it requires a rebuild.
# PRECOMPRESS_BROTLI_QUALITY=11
